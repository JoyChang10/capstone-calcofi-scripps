lambda <- 0.35
pred.tr <- predict(fit2, n.ahead = 60)
InvBoxCox <- function(x, lambda) {
if (lambda == 0) return(exp(x))
else return((lambda * x + 1)^(1 / lambda))
}
pred.orig <- InvBoxCox(pred.tr$pred, lambda)
U.tr <- InvBoxCox(pred.tr$pred + 2 * pred.tr$se, lambda)
L.tr <- InvBoxCox(pred.tr$pred - 2 * pred.tr$se, lambda)
ts.plot(training, xlim = c(1, length(training) + 60),
ylim = c(min(training), max(U.tr)),
col = "black",
main = "60-Step Forecast on Original Data",
ylab = "Original Data", xlab = "Time")
lines((length(sunspot.bc) + 1):(length(sunspot.bc) + 60),
pred.tr$pred, col = "black")
lines(U.tr, col = "blue", lty = "dashed")
lines(L.tr, col = "blue", lty = "dashed")
points((length(training) + 1):(length(training) + 60),
pred.orig, col = "red", pch = 1)
