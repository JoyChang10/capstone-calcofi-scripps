install.packages("patchwork")
library(DBI)
library(duckdb)
library(dplyr)
library(ggplot2)
library(scales)
library(patchwork)
# ---- connect ----
DUCKDB_PATH <- "/Users/kaeya/capstonerep/capstone-calcofi-scripps/preliminaryanalysis/kaeya/prototype.duckdb"
TABLE_NAME  <- "ichthyoplankton_observations"
con <- dbConnect(duckdb::duckdb(), dbdir = DUCKDB_PATH, read_only = TRUE)
# ---- pull raw data with year ----
raw <- dbGetQuery(con, paste("SELECT taxon, abundance, year FROM", TABLE_NAME))
dbDisconnect(con)
# ---- assign time periods ----
df <- raw %>%
filter(!is.na(year), !is.na(abundance)) %>%
mutate(period = case_when(
year >= 1950 & year <= 1976 ~ "1950–1976\n(50s sampled yearly; 60s every 3rd year)",
year >= 1978 & year <= 1998 ~ "1978–1998\n(1977 skipped — no sampling)",
year >= 1999 & year <= 2013 ~ "1999–2013\n(Cool period)",
year >= 2014             ~ "2014–Present\n(Warm period)",
TRUE ~ NA_character_
)) %>%
filter(!is.na(period))
# ---- top 10 per period ----
top10_by_period <- df %>%
group_by(period, taxon) %>%
summarise(total_abundance = sum(abundance, na.rm = TRUE), .groups = "drop") %>%
group_by(period) %>%
slice_max(total_abundance, n = 10) %>%
mutate(taxon = reorder(taxon, total_abundance))
# ---- period order ----
period_order <- c(
"1950–1976\n(50s sampled yearly; 60s every 3rd year)",
"1978–1998\n(1977 skipped — no sampling)",
"1999–2013\n(Cool period)",
"2014–Present\n(Warm period)"
)
period_colors <- c(
"1950–1976\n(50s sampled yearly; 60s every 3rd year)" = "#4e79a7",
"1978–1998\n(1977 skipped — no sampling)"            = "#f28e2b",
"1999–2013\n(Cool period)"                           = "#76b7b2",
"2014–Present\n(Warm period)"                        = "#e15759"
)
# ---- build one plot per period ----
make_plot <- function(period_label) {
data <- top10_by_period %>% filter(period == period_label)
ggplot(data, aes(x = total_abundance, y = taxon)) +
geom_bar(stat = "identity", fill = period_colors[period_label], alpha = 0.85) +
scale_x_continuous(labels = comma, expand = expansion(mult = c(0, 0.12))) +
labs(
title = period_label,
x = "Total Abundance",
y = NULL
) +
theme_minimal(base_size = 11) +
theme(
plot.title    = element_text(face = "bold", size = 11),
axis.text.y   = element_text(face = "italic", size = 9),
panel.grid.major.y = element_blank(),
panel.grid.minor   = element_blank()
)
}
plots <- lapply(period_order, make_plot)
# ---- combine with patchwork ----
combined_plot <- (plots[[1]] | plots[[2]]) / (plots[[3]] | plots[[4]]) +
plot_annotation(
title    = "Top 10 Species by Total Abundance Across Time Periods",
subtitle = "CalCOFI Ichthyoplankton Observations",
theme = theme(
plot.title    = element_text(face = "bold", size = 14),
plot.subtitle = element_text(color = "gray50", size = 10)
)
)
print(combined_plot)
# ---- save ----
ggsave("~/Desktop/abundance_by_period.png", combined_plot, width = 14, height = 10, dpi = 150)
library(DBI)
library(duckdb)
library(dplyr)
library(ggplot2)
library(patchwork)
# ---- connect ----
DUCKDB_PATH <- "/Users/kaeya/capstonerep/capstone-calcofi-scripps/preliminaryanalysis/kaeya/prototype.duckdb"
TABLE_NAME  <- "ichthyoplankton_observations"
con <- dbConnect(duckdb::duckdb(), dbdir = DUCKDB_PATH, read_only = TRUE)
# ---- pull raw data ----
raw <- dbGetQuery(con, paste("SELECT abundance, year FROM", TABLE_NAME))
dbDisconnect(con)
# ---- assign time periods ----
df <- raw %>%
filter(!is.na(year), !is.na(abundance)) %>%
mutate(period = case_when(
year >= 1950 & year <= 1976 ~ "1950-1976",
year >= 1978 & year <= 1998 ~ "1978-1998",
year >= 1999 & year <= 2013 ~ "1999-2014",
year >= 2014               ~ "2014-present",
TRUE ~ NA_character_
)) %>%
filter(!is.na(period))
# ---- total abundance per year ----
summary_df <- df %>%
group_by(period, year) %>%
summarise(total_abundance = sum(abundance, na.rm = TRUE), .groups = "drop")
# ---- plot function ----
make_plot <- function(period_label, show_y = TRUE) {
data <- summary_df %>% filter(period == period_label)
ggplot(data, aes(x = year, y = total_abundance)) +
geom_line(color = "#2ec4b6", linewidth = 0.9) +
geom_point(color = "#2ec4b6", size = 1.8) +
scale_x_continuous(breaks = scales::pretty_breaks(n = 5)) +
scale_y_continuous(labels = scales::comma) +
labs(
title = period_label,
x = NULL,
y = if (show_y) "Total Abundance" else NULL
) +
theme_minimal(base_size = 11) +
theme(
plot.title       = element_text(size = 10, hjust = 0.5, color = "gray30"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "gray90"),
panel.background = element_rect(fill = "gray97", color = NA),
axis.text.y      = if (show_y) element_text() else element_blank()
)
}
# ---- build four panels ----
p1 <- make_plot("1950-1976",    show_y = TRUE)
p2 <- make_plot("1978-1998",    show_y = FALSE)
p3 <- make_plot("1999-2014",    show_y = TRUE)
p4 <- make_plot("2014-present", show_y = FALSE)
# ---- combine ----
combined_plot <- (p1 | p2) / (p3 | p4) +
plot_annotation(
title = "Time Series of Total Abundance by Period",
theme = theme(plot.title = element_text(face = "bold", size = 13))
)
print(combined_plot)
# ---- save ----
ggsave("~/Desktop/total_abundance_timeseries.png", combined_plot, width = 14, height = 9, dpi = 150)
