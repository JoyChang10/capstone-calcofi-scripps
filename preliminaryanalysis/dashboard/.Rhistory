library(DBI)
library(duckdb)
library(dplyr)
library(ggplot2)
# ---- connect ----
DUCKDB_PATH <- "/Users/kaeya/capstonerep/capstone-calcofi-scripps/preliminaryanalysis/kaeya/prototype.duckdb"
TABLE_NAME  <- "ichthyoplankton_observations"
con <- dbConnect(duckdb::duckdb(), dbdir = DUCKDB_PATH, read_only = TRUE)
raw <- dbGetQuery(con, paste("SELECT abundance, year FROM", TABLE_NAME))
dbDisconnect(con)
# ---- assign time periods ----
df <- raw %>%
filter(!is.na(year), !is.na(abundance)) %>%
mutate(period = case_when(
year >= 1950 & year <= 1976 ~ "1: 1950-1976",
year >= 1978 & year <= 1998 ~ "2: 1978-1998",
year >= 1999 & year <= 2013 ~ "3: 1999-2014",
year >= 2014               ~ "4: 2014-present",
TRUE ~ NA_character_
)) %>%
filter(!is.na(period))
# ---- total abundance per year ----
summary_df <- df %>%
group_by(period, year) %>%
summarise(total_abundance = sum(abundance, na.rm = TRUE), .groups = "drop")
# ---- plot with facet_wrap ----
ggplot(summary_df, aes(x = year, y = total_abundance)) +
geom_line(color = "#2ec4b6", linewidth = 0.9) +
geom_point(color = "#2ec4b6", size = 1.8) +
facet_wrap(~ period, nrow = 2, scales = "free_x") +  # free x so each panel shows its own years
scale_y_continuous(labels = scales::comma) +          # y axis is shared and identical
labs(
title = "Time Series of Total Abundance by Period",
x = NULL,
y = "Total Abundance"
) +
theme_minimal(base_size = 11) +
theme(
plot.title       = element_text(face = "bold", size = 13),
strip.text       = element_text(size = 10, color = "gray30"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "gray90"),
panel.background = element_rect(fill = "gray97", color = NA)
)
ggsave("~/Desktop/total_abundance_timeseries.png", width = 14, height = 9, dpi = 150)
